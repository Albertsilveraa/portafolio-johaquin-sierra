---
const phrase = 'MARKETING · GROWTH · CONTENIDO';
---
<div class="overflow-hidden border-y border-line bg-surface py-3" aria-hidden="true">
  <div class="flex w-max animate-marquee items-center gap-6 whitespace-nowrap font-display text-base font-medium uppercase tracking-widest motion-reduce:animate-none">
    {Array.from({ length: 8 }).map((_, i) => (
      <>
        <span class={i % 2 === 0 ? 'text-fg' : 'text-accent'}>{phrase}</span>
        <span class="text-accent" aria-hidden="true">✦</span>
      </>
    ))}
  </div>
</div>
