---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---
<section id="contacto" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
  <SectionHeading index="04" title="Contacto" />
  <div class="mt-8 flex flex-col gap-4 text-lg" data-reveal>
    <a href={`mailto:${profile.contact.email}`} class="group flex w-fit items-center gap-2 hover:text-accent">
      {profile.contact.email}
      <span class="opacity-0 transition-opacity group-hover:opacity-100">↗</span>
    </a>
    <a href={`tel:${profile.contact.phone.replace(/\s/g, '')}`} class="group flex w-fit items-center gap-2 hover:text-accent">
      {profile.contact.phone}
      <span class="opacity-0 transition-opacity group-hover:opacity-100">↗</span>
    </a>
    <a href={profile.contact.linkedin} class="group flex w-fit items-center gap-2 hover:text-accent">
      LinkedIn
      <span class="opacity-0 transition-opacity group-hover:opacity-100">↗</span>
    </a>
  </div>
</section>
