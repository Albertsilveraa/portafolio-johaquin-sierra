---
interface Props {
  index: string;
  title: string;
}
const { index, title } = Astro.props;
---
<div class="flex items-center gap-4" data-reveal>
  <span class="font-display text-xs text-accent">({index})</span>
  <h2 class="font-display text-sm uppercase tracking-widest text-muted">{title}</h2>
  <span class="h-px flex-1 bg-line"></span>
</div>
