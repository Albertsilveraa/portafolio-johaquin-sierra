---
import type { Project } from '../data/projects';
import { withBase } from '../lib/url';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const modalId = `modal-${project.code.toLowerCase()}`;
---
<dialog id={modalId} data-project-modal aria-labelledby={`${modalId}-title`}>
  <div class="max-h-[85vh] overflow-y-auto rounded-2xl border border-line bg-surface p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3 font-display text-xs uppercase tracking-widest text-muted">
        <span class="text-accent">{project.code}</span>
        <span>{project.year}</span>
      </div>
      <button
        type="button"
        data-close-modal
        class="rounded-full border border-line p-1.5 text-muted transition-colors hover:border-accent hover:text-accent"
        aria-label="Cerrar vista previa"
      >
        ✕
      </button>
    </div>
    <img
      src={withBase(project.coverImage)}
      alt={`Portada de ${project.title}`}
      class="mt-4 aspect-[16/10] w-full rounded-lg object-cover"
      loading="lazy"
    />
    <h3 id={`${modalId}-title`} class="mt-6 font-display text-2xl font-semibold">{project.title}</h3>
    <p class="mt-3 text-base text-muted">{project.summary}</p>
    <p class="mt-4 font-display text-sm font-medium text-accent">{project.metric}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">{tag}</li>
      ))}
    </ul>
    <div class="mt-6 flex flex-wrap gap-3 border-t border-line pt-6">
      {project.assets.map((asset) => (
        <a
          href={withBase(asset.href)}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-fg underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
        >
          {project.assets.length > 1 ? asset.label : 'Ver PDF completo'} ↗
        </a>
      ))}
    </div>
  </div>
</dialog>
